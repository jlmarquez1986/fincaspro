# ── Configuración de FincasPro ────────────────────────────
# Copia este archivo a .env y ajusta los valores

# Entorno: development | production
ENVIRONMENT=development

# Nombre de la comunidad, tal y como se muestra en toda la app (pantallas
# de login, panel de staff, y firma de los emails que se envían).
COMMUNITY_NAME=Comunidad El Roble

# Clave para firmar los JWT. OBLIGATORIA en producción.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos
DATABASE_URL=sqlite:///./fincaspro.db

# Zona horaria para las fechas que aparecen DENTRO del texto de los emails
# (en la propia web, la hora se ajusta sola a la del dispositivo de quien
# la ve; en un email, hay que fijar una). Usa un nombre de la base de datos
# de zonas horarias IANA, por ejemplo: Europe/Madrid, America/Bogota,
# America/Mexico_City, America/Argentina/Buenos_Aires.
APP_TIMEZONE=Europe/Madrid

# Email SMTP (desarrollo local con MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=fincaspro@comunidad.local
SMTP_TLS=false

# Para producción con Gmail, Outlook, SendGrid, Brevo, etc.:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-contraseña-de-app
# SMTP_FROM=tu-email@gmail.com
# SMTP_TLS=true
