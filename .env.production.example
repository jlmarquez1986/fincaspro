# Copia este archivo como .env.production y rellena los valores.
# NO subas .env.production al repositorio.

COMMUNITY_NAME=Comunidad El Roble

# Genera una clave fuerte y aleatoria:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_Y_SECRETA

DATABASE_URL=sqlite:////data/fincaspro.db
APP_TIMEZONE=Europe/Madrid
ACCESS_TOKEN_EXPIRE_MINUTES=480

# La app se sirve desde el mismo origen mediante Nginx.
CORS_ORIGINS=http://localhost

# SMTP de producción
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASS=CAMBIA_ESTA_CONTRASENA
SMTP_FROM=usuario@example.com
SMTP_TLS=true

MIGRATE_ON_STARTUP=true
UVICORN_WORKERS=1
HTTP_PORT=80
